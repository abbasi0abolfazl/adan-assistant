    {
      "id": "sql_calculator_growth",
      "http_status": 200,
      "passed": true,
      "errors": [],
      "request": {
        "question": "Using the Calculator Tool, what was the percentage growth in completed-order revenue from Gregorian January 2026 to Gregorian February 2026?",
        "language": "en"
      },
      "response": {
        "request_id": "0568dd44-abbe-4245-8851-632f48f2318f",
        "status": "answered",
        "answer": "Completed-order revenue grew by 25.00% from Gregorian January 2026 (IRR 100,000,000) to Gregorian February 2026 (IRR 125,000,000).",
        "route": "hybrid",
        "sources": [
          {
            "source_id": "sales_handbook:p1:c1:b5286c86",
            "filename": "sales_handbook.pdf",
            "title": "Sales reporting and provisional reserve",
            "page": 1,
            "score": 0.515322,
            "document_sha256": "b5286c868da3dae038db426437c6f4139e95d40daf0e921a2b2b89dce811b202",
            "quote": "For this demo, sales revenue means the sum of item quantity multiplied by its historical unit price, minus the line-level discount, for completed orders. Cancelled orders are excluded unless a question explicitly asks about them. The discount field stores the total discount for a complete order line. It must not be multiplied by quantity again. Revenue is derived from order items, not current product prices. All sample amounts are integer Iranian rials, with currency code IRR. No implicit conversion to toman is permitted. Dates in the database use the Gregorian calendar in YYYY-MM-DD format. Revenue does not include shipping, tax or post-sale refunds."
          }
        ],
        "sql": [
          {
            "id": "sql_1",
            "generated_sql": "WITH monthly_revenue AS (\n  SELECT\n    strftime('%Y-%m', o.order_date) AS year_month,\n    SUM(oi.quantity * oi.unit_price_irr - oi.discount_irr) AS total_revenue_irr\n  FROM orders AS o\n  JOIN order_items AS oi ON oi.order_id = o.order_id\n  WHERE o.status = 'completed'\n    AND o.order_date >= ?\n    AND o.order_date < ?\n  GROUP BY strftime('%Y-%m', o.order_date)\n)\nSELECT\n  year_month,\n  total_revenue_irr\nFROM monthly_revenue\nORDER BY year_month",
            "executed_sql": "SELECT * FROM (WITH monthly_revenue AS (\n  SELECT\n    strftime('%Y-%m', o.order_date) AS year_month,\n    SUM(oi.quantity * oi.unit_price_irr - oi.discount_irr) AS total_revenue_irr\n  FROM orders AS o\n  JOIN order_items AS oi ON oi.order_id = o.order_id\n  WHERE o.status = 'completed'\n    AND o.order_date >= ?\n    AND o.order_date < ?\n  GROUP BY strftime('%Y-%m', o.order_date)\n)\nSELECT\n  year_month,\n  total_revenue_irr\nFROM monthly_revenue\nORDER BY year_month) AS result LIMIT 101",
            "parameters": [
              "2026-01-01",
              "2026-03-01"
            ],
            "columns": [
              "year_month",
