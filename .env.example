# API credentials are required for REAL embeddings, routing, NL2SQL and answers.
# Never commit a populated .env. No fake runtime mode is provided.

PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini-2026-03-17
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
DATA_DIR=data
RUNTIME_DIR=runtime
CHUNK_WORDS=180
CHUNK_OVERLAP=30
RETRIEVAL_TOP_K=4
# Initial heuristic, NOT a calibrated confidence probability.
RETRIEVAL_MIN_SCORE=0.25
PROVIDER_TIMEOUT_SECONDS=40
REQUEST_DEADLINE_SECONDS=150
SQL_TIMEOUT_SECONDS=1
SQL_MAX_ROWS=100
SQL_VM_STEPS=100000
MAX_INFLIGHT=4
